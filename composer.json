{
    "name": "elbandi/exchange-notify",
    "description": "Notify exchange trades and transactions",
    "keywords": ["cryptocurrency", "exchange", "trade", "transactions", "console", "cli"],
    "homepage": "https://laravel-zero.com",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/bitbandi/exchange-notify/issues",
        "source": "https://github.com/bitbandi/exchange-notify"
    },
    "authors": [
        {
            "name": "Elbandi",
            "email": "bandispam@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "henzeb/laravel-console-facade",
                "version": "1.19.0",
                "dist": {
                    "url": "https://api.github.com/repos/henzeb/laravel-console-facade/zipball/4064111abc1ee27bcabfef6f5ce40e8a931ba16b",
                    "type": "zip"
                },
                "require": {
                    "php": "^8.1",
                    "illuminate/support": "^10|^11|^12|^13"
                },
                "autoload": {
                    "files": ["src/Functions/Functions.php"],
                    "psr-4": {
                        "Henzeb\\Console\\": "src/"
                    }
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/bitbandi/etherscan-client-php",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/bitbandi/cow-api-php",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "amashukov/etherscan-client-php": "dev-main",
        "ccxt/ccxt": "^4.5",
        "elbandi/cow-api": "*",
        "henzeb/laravel-console-facade": "^1.19",
        "illuminate/database": "^13.0.0",
        "illuminate/log": "^13.0",
        "illuminate/notifications": "^13.0.0",
        "illuminate/view": "^13.0.0",
        "laravel-notification-channels/discord": "^1.8",
        "laravel-notification-channels/pushover": "^5.0.1",
        "laravel-notification-channels/telegram": "^8.0.0",
        "laravel-zero/framework": "^13.0.0",
        "laravel/slack-notification-channel": "^3.10.0",
        "nesbot/carbon": "^3.14.2",
        "php-pushover/php-pushover": "^1.0.1",
        "pragmarx/yaml": "^1.3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "mockery/mockery": "^1.6.15",
        "pestphp/pest": "^5.3.2"
    },
    "conflict": {
        "laravel-zero/foundation": "<13.23.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": {
            "ccxt/ccxt": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["exchange-notify"]
}
